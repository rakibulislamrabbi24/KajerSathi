{
  "name": "kajersathi",
  "version": "2.0.0",
  "description": "KajerSathi (কাজের সাথী): আপনার ডিজিটাল কাজের বিশ্বস্ত সাথী. Your trusted digital daily utility companion. 100% client-side web tools (PWA).",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/app.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/app.css --watch",
    "stamp": "node scripts/stamp-sw.mjs",
    "compile": "npm run build:css && npm run stamp"
  },
  "keywords": [
    "kajersathi",
    "bangla",
    "qr-code",
    "pwa",
    "client-side"
  ],
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "diceware-wordlist-en-eff": "^1.0.1",
    "easyqrcodejs": "^4.6.1",
    "fflate": "^0.8.3",
    "html5-qrcode": "^2.3.8",
    "lucide": "^0.469.0",
    "tailwindcss": "^3.4.17"
  },
  "private": true,
  "homepage": "https://kajersathi.vercel.app/"
}
